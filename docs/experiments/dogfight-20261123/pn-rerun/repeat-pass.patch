diff --git a/scripts/trial-repeat-pass.cjs b/scripts/trial-repeat-pass.cjs
new file mode 100644
index 0000000..f84ea0a
--- /dev/null
+++ b/scripts/trial-repeat-pass.cjs
@@ -0,0 +1,43 @@
+// Optional arcade pilot. Each pair remembers its own preceding frontal encounter.
+function durability(unit) {
+  const sections = unit.sec || [];
+  const capacity = sections.reduce((n, part) => n + part.max, 0);
+  const hull = capacity ? sections.reduce((n, part) => n + Math.max(0, part.s), 0) / capacity : 0;
+  return hull + (unit.shieldMax > 0 ? unit.shield / unit.shieldMax : 0);
+}
+
+function faces(unit, direction) {
+  const f = unit.att?.f || [Math.cos(unit.yaw), 0, Math.sin(unit.yaw)];
+  return f.reduce((sum, n, i) => sum + n * direction[i], 0) > 0.5;
+}
+
+function repeatPass(u, old, target, time) {
+  const pairs = u.trialPairHistory ||= new Map();
+  const delta = target.pos.map((x, i) => x - old.pos[i]);
+  const distance = Math.hypot(...delta);
+  const direction = delta.map(x => x / (distance || 1));
+  let pair = pairs.get(target.id);
+  if (!pair) {
+    pair = {count: 0, active: false, ownLoss: 0, otherLoss: 0};
+    pairs.set(target.id, pair);
+  }
+  if (pair.active && distance > 3000) pair.active = false;
+  if (!pair.active && distance <= 3000 && faces(old, direction) && faces(target, direction.map(x => -x))) {
+    pair.active = true;
+    pair.count++;
+    pair.dodge = pair.count > 1 && pair.ownLoss > pair.otherLoss;
+    if (process.env.KS_PASS_LOG) require('node:fs').appendFileSync(process.env.KS_PASS_LOG,
+      JSON.stringify({seed:u.trialPassSeed, time, unit:u.id, target:target.id, encounter:pair.count, dodge:pair.dodge,
+        ownLoss:pair.ownLoss, otherLoss:pair.otherLoss})+'\n');
+    pair.until = time + 3;
+    pair.own = durability(old);
+    pair.other = durability(target);
+    pair.ownLoss = pair.otherLoss = 0;
+  }
+  if (!pair.active) return null;
+  pair.ownLoss = Math.max(pair.ownLoss, pair.own - durability(old));
+  pair.otherLoss = Math.max(pair.otherLoss, pair.other - durability(target));
+  if (!pair.dodge || time >= pair.until) return null;
+  return [old.pos[0] - 1000 * Math.sin(old.yaw), old.pos[1], old.pos[2] + 1000 * Math.cos(old.yaw)];
+}
+module.exports = {repeatPass};
